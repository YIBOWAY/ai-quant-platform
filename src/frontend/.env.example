# Backend API used by the local frontend.
NEXT_PUBLIC_QUANT_API_BASE_URL="http://127.0.0.1:8765"

# Hermes workbench shell (default on). Set false to hide shell chrome.
# QS_HERMES_SHELL_ENABLED=true

# Local single-user chat unlock. Pair with API QS_LOCAL_MUTATION_*.
# With BFF L2a wiring, this enables draft + composite network submit (local dark).
# Public cutover / V8 remains separate and default closed.
# QS_HERMES_CHAT_ENABLED=false
