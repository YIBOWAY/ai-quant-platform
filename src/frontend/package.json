{
  "name": "ai-quant-platform-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\" && next build",
    "start": "next start",
    "test": "vitest run",
    "generate:api-types": "node scripts/generate-api-types.mjs",
    "check:api-types": "npm run generate:api-types && git diff --exit-code -- lib/api.generated.ts",
    "lint": "eslint app components lib tests playwright.config.ts eslint.config.mjs next.config.ts",
    "type-check": "tsc --noEmit",
    "clean": "next clean",
    "test:e2e": "playwright test",
    "test:e2e:gate5": "node scripts/run-hermes-gate5.mjs",
    "test:support": "node --test tests/support/hermes-fixture-api.test.mjs tests/support/hermes-e2e-run-root.test.mjs",
    "test:gate5-support": "node --test tests/support/hermes-fixture-api.test.mjs tests/support/hermes-e2e-run-root.test.mjs scripts/run-hermes-gate5.test.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@tanstack/react-query": "^5.100.6",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.74.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.15"
  }
}
