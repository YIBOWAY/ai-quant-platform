{
  "cases": [
    {
      "category": "membership",
      "defective": true,
      "expected_defect": "cross-sectional rank includes ineligible peers",
      "id": "M02",
      "source": "import numpy as np\nimport pandas as pd\ndef compute(ohlcv, context):\n    f = ohlcv.copy()\n    required_close = f[\"close\"]\n    f.loc[f.available_at > f.timestamp, [\"open\",\"high\",\"low\",\"close\",\"volume\"]] = np.nan\n    g = f.groupby(\"symbol\", sort=False)\n    score = f.groupby(\"timestamp\").close.rank(pct=True)\n    score = pd.Series(score, index=f.index, dtype=float)\n    score = score.where(f.eligible & f.close.notna() & (f.available_at <= f.timestamp))\n    return f[[\"symbol\",\"timestamp\"]].assign(score=score)\n",
      "source_sha256": "8e3df7f660e05ecbbdaad2631457815f4fb030eb2603d0542148020c1459f812"
    },
    {
      "category": "membership",
      "defective": true,
      "expected_defect": "terminal membership retrospectively removes prior members",
      "id": "M03",
      "source": "import numpy as np\nimport pandas as pd\ndef compute(ohlcv, context):\n    f = ohlcv.copy()\n    required_close = f[\"close\"]\n    f.loc[f.available_at > f.timestamp, [\"open\",\"high\",\"low\",\"close\",\"volume\"]] = np.nan\n    g = f.groupby(\"symbol\", sort=False)\n    last = g.eligible.transform(\"last\")\n    score = f.close.where(last)\n    score = pd.Series(score, index=f.index, dtype=float)\n    score = score.where(f.eligible & f.close.notna() & (f.available_at <= f.timestamp))\n    return f[[\"symbol\",\"timestamp\"]].assign(score=score)\n",
      "source_sha256": "41931ec7f60302dafe20c78888633b0e2964ab54507d83f6c4a71cb4787b485a"
    },
    {
      "category": "membership",
      "defective": true,
      "expected_defect": "hard-coded present-day whitelist drops DELTA at every date",
      "id": "M04",
      "source": "import numpy as np\nimport pandas as pd\ndef compute(ohlcv, context):\n    f = ohlcv.copy()\n    required_close = f[\"close\"]\n    f.loc[f.available_at > f.timestamp, [\"open\",\"high\",\"low\",\"close\",\"volume\"]] = np.nan\n    g = f.groupby(\"symbol\", sort=False)\n    score = f.close.where(f.symbol.isin([\"ALPHA\", \"BETA\", \"GAMMA\"]))\n    score = pd.Series(score, index=f.index, dtype=float)\n    score = score.where(f.eligible & f.close.notna() & (f.available_at <= f.timestamp))\n    return f[[\"symbol\",\"timestamp\"]].assign(score=score)\n",
      "source_sha256": "b0e8880644a6c5f5e5b94380ac6fecec917495ff5f5654402a22db447958d404"
    },
    {
      "category": "missing_data",
      "defective": true,
      "expected_defect": "missing observation silently becomes zero in next return",
      "id": "E01",
      "source": "import numpy as np\nimport pandas as pd\ndef compute(ohlcv, context):\n    f = ohlcv.copy()\n    required_close = f[\"close\"]\n    f.loc[f.available_at > f.timestamp, [\"open\",\"high\",\"low\",\"close\",\"volume\"]] = np.nan\n    g = f.groupby(\"symbol\", sort=False)\n    filled = f.close.fillna(0)\n    score = filled - filled.groupby(f.symbol).shift(1)\n    score = pd.Series(score, index=f.index, dtype=float)\n    score = score.where(f.eligible & f.close.notna() & (f.available_at <= f.timestamp))\n    return f[[\"symbol\",\"timestamp\"]].assign(score=score)\n",
      "source_sha256": "f3431f7ec987090655cf60e270c5a78763111ddda701ec7570ed2798b90836d9"
    }
  ],
