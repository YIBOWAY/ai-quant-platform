<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aiquant.paper-sleeves.ops-status</string>
  <key>ProgramArguments</key>
  <array>
    <string>__ROOT__/scripts/run_paper_strategy_sleeves.sh</string>
    <string>ops-status</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__ROOT__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__ROOT__/data/_runtime/logs/paper-sleeves-ops-status.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/data/_runtime/logs/paper-sleeves-ops-status.launchd.err.log</string>
</dict>
</plist>
