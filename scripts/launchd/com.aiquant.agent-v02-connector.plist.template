<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aiquant.agent-v02-connector</string>
  <key>ProgramArguments</key>
  <array>
    <string>__ROOT__/scripts/run_agent_v02_connector.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__ROOT__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__ROOT__/data/_runtime/logs/agent-v02-connector.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/data/_runtime/logs/agent-v02-connector.launchd.err.log</string>
</dict>
</plist>
