# Copy to an owner-only file outside Git and point QS_D34_ENV_FILE at it.
# Pinned RD-Agent LiteLLM settings require the LITELLM_ prefix.
# LiteLLM 1.96 needs a provider prefix when OPENAI_API_BASE is set.
# openai/grok-4.6 walks the OpenAI-compatible proxy; grok-4.6 does not.
LITELLM_CHAT_MODEL=openai/grok-4.6
LITELLM_REASONING_EFFORT=xhigh
# Provider credentials stay in LiteLLM-native variables so RD-Agent does not
# include them in its logged LITELLM settings object.
# Hermes xAI OAuth proxy (same Grok subscription as chat).
# Inside Docker, 127.0.0.1 is the container. Use host.docker.internal.
# Set a real Hermes proxy token. Short placeholders are rejected by the worker.
OPENAI_API_KEY=
OPENAI_API_BASE=http://host.docker.internal:8645/v1
LITELLM_MAX_RETRY=3
LITELLM_RETRY_WAIT_SECONDS=2
LITELLM_LOG_LLM_CHAT_CONTENT=false
